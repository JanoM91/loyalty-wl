{
  "name": "@wl/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3200",
    "build": "next build",
    "vercel-build": "pnpm --filter @wl/database generate && pnpm --filter @wl/database migrate:si-toca && next build",
    "start": "next start --port 3200",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/fredoka": "^5.3.0",
    "@fontsource-variable/onest": "^5.3.1",
    "@prisma/client": "5.22.0",
    "@vercel/blob": "^0.27.0",
    "@wl/database": "workspace:*",
    "@wl/domain": "workspace:*",
    "jsqr": "1.4.0",
    "next": "^15.0.3",
    "passkit-generator": "^3.7.0",
    "qrcode": "1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/qrcode": "1.5.5",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.1",
    "@wl/config": "workspace:*",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  },
  "engines": {
    "node": "22.x"
  }
}
