# Copia este archivo como .env.local (en la raíz) y llena los valores.
# Nunca subas .env.local al repositorio.

# --- Base de datos (PostgreSQL / Neon) ---
# DOS roles distintos, a propósito (ver docs/02-aislamiento.md):
# - DATABASE_URL: el rol de la APLICACIÓN (miembro de wl_app, sin BYPASSRLS).
#   Con este rol la base solo deja ver las filas del negocio en curso.
# - DIRECT_URL: el rol DUEÑO. Solo lo usan las migraciones, la siembra y el
#   alta de negocios. La aplicación se niega a arrancar consultas con él.
DATABASE_URL="postgresql://wl_web:CAMBIA@host/base?sslmode=require"
DIRECT_URL="postgresql://dueno:CAMBIA@host/base?sslmode=require"

# --- Dominio ---
# Dominio raíz de la plataforma. Cada negocio vive en <slug>.<este dominio>.
# En tu computadora no hace falta: funciona <slug>.localhost:3200.
WL_DOMINIO_RAIZ=""

# Solo para una instalación PRIVADA (un negocio con su propio proyecto y base):
# el slug de ese negocio. Con esto, cualquier dominio que apunte al proyecto
# abre su programa, sin subdominios. En la instalación compartida va vacío.
WL_NEGOCIO_UNICO=""

# --- Correo (Resend). Sin estos dos, los correos no se envían. ---
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""

# --- Fotos de tickets (Vercel Blob). Sin token, la caja registra sin foto. ---
BLOB_READ_WRITE_TOKEN=""

# --- Tarea diaria de limpieza de fotos (Vercel Cron) ---
CRON_SECRET=""

# --- Página de inicio del sitio compartido ---
# Nombre comercial del sitio (pendiente) y WhatsApp de contacto (10 dígitos con 52).
WL_NOMBRE_SITIO=""
WL_CONTACTO_WHATSAPP=""

# --- Apple Wallet. Ver docs/07-wallet.md. Sin estas, no se ofrece el pase. ---
# Un emisor para toda la instalación; cada pase lleva la marca de su negocio.
APPLE_PASS_TYPE_ID=""
APPLE_TEAM_ID=""
APPLE_PASS_CERT_BASE64=""
APPLE_PASS_KEY_BASE64=""
APPLE_PASS_KEY_PASSPHRASE=""
APPLE_WWDR_CERT_BASE64=""

# --- Google Wallet. Ver docs/07-wallet.md. ---
GOOGLE_WALLET_ISSUER_ID=""
GOOGLE_WALLET_SA_EMAIL=""
GOOGLE_WALLET_SA_KEY_BASE64=""
# "1" cuando Google apruebe la publicación; antes, el botón no se muestra al público.
GOOGLE_WALLET_PUBLICO="0"
