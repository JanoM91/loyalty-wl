{
  "name": "@wl/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "generate": "prisma generate",
    "generate:wasm": "node scripts/prisma-wasm.mjs",
    "migrate": "node --env-file-if-exists=../../.env.local ./node_modules/prisma/build/index.js migrate dev",
    "migrate:deploy": "node --env-file-if-exists=../../.env.local ./node_modules/prisma/build/index.js migrate deploy",
    "seed": "tsx --env-file-if-exists=../../.env.local prisma/seed.ts",
    "studio": "node --env-file-if-exists=../../.env.local ./node_modules/prisma/build/index.js studio",
    "build": "node scripts/generar.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf dist .turbo",
    "invitar": "tsx --env-file-if-exists=../../.env.local scripts/invitar.ts",
    "plataforma:usuario": "tsx --env-file-if-exists=../../.env.local scripts/plataforma-usuario.ts"
  },
  "prisma": {
    "seed": "tsx --env-file-if-exists=../../.env.local prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "@wl/domain": "workspace:*"
  },
  "devDependencies": {
    "@prisma/adapter-pg": "5.22.0",
    "@types/pg": "^8.11.10",
    "pg": "^8.13.1",
    "prisma": "5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  }
}
